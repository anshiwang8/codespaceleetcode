# Where the browser loads snapshot files from. Unset, the app serves them itself.
NEXT_PUBLIC_SNAPSHOT_CDN_URL=
# Better Auth. The secret signs session cookies: at least 32 random characters, required in
# production (openssl rand -base64 32). The URL is the site's own origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# A GitHub OAuth app, with the callback <BETTER_AUTH_URL>/api/auth/callback/github. Without both,
# GitHub sign-in is off and only the localhost dev login is offered.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required in production. Defaults to the local database otherwise.
DATABASE_URL=
# Where /snapshots/<name>/... reads from. Defaults to ../ingest/out outside production.
SNAPSHOT_DIR=
# One more hostname the dev login accepts, for a test setup that isn't on localhost.
DEV_AUTH_TEST_HOST=
# Where tests find a Postgres server. They use their own database on it. Must be local.
TEST_DATABASE_URL=
# Contact email confirmation (spec.md section 14, M10), through Resend or any SMTP server.
# Resend: RESEND_API_KEY and EMAIL_FROM, a sender on a domain verified in Resend, such as
# "codebases <noreply@mail.example.com>". It wins when both providers are set.
# SMTP: SMTP_HOST, SMTP_USER and SMTP_PASSWORD; SMTP_PORT defaults to 465 (TLS), and any other port
# must offer STARTTLS. For Gmail: smtp.gmail.com, the Gmail address, and an app password made at
# myaccount.google.com/apppasswords. EMAIL_FROM defaults to SMTP_USER; Gmail only sends as that
# account or its verified aliases.
# With neither, outside production, messages are written to DEV_OUTBOX_DIR instead of being sent; in
# production, Settings says email is unavailable.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Where unsent local email is saved. Defaults to web/.dev-outbox.
DEV_OUTBOX_DIR=
